# Base URL the browser uses for API calls.
# Keep "/api" in development to go through the Vite proxy (no CORS issues).
VITE_API_URL=/api

# Where the Vite dev proxy forwards /api (Laravel backend).
# Docker: http://localhost:8080   |   php artisan serve: http://127.0.0.1:8000
VITE_API_PROXY_TARGET=http://localhost:8080
